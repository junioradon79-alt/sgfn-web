Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# MIME types explicites pour les assets
AddType text/css .css
AddType application/javascript .js
AddType application/json .json
AddType image/svg+xml .svg
AddType font/woff2 .woff2

# Autoriser explicitement l'accès aux fichiers (contourne un éventuel
# blocage des chemins commençant par underscore, ex. _next/)
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

# En-têtes de sécurité (audit 12/07/2026)
# - HSTS sans includeSubDomains : monterrain.sgfn.ci et les sous-domaines cPanel
#   ne sont pas garantis HTTPS-only.
# - Pas de CSP : Next.js injecte des scripts inline, une CSP stricte casserait le site.
# - camera/geolocation=(self) : requis par le scan QR de /verifier.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=()"
</IfModule>

# Politique de cache (ajoutée le 17/07/2026)
# Symptôme observé : après un déploiement, un navigateur continue de servir
# l'ANCIENNE application pendant des heures. Cause : le HTML n'avait aucun
# en-tête de cache → Chrome applique un cache heuristique (~10 % de l'âge du
# fichier) et ressert un HTML périmé, qui référence d'anciens noms de chunks
# toujours présents sur le serveur (l'extraction d'un tar.gz n'efface rien).
#
# Approche volontairement compatible Apache 2.2 ET 2.4 : SetEnvIf + FilesMatch,
# pas de <If> (2.4 seulement — un serveur 2.2 renverrait 500 sur tout le site).
# Le cache immutable est scopé au CHEMIN /_next/static/ (pas à l'extension .js),
# sinon on figerait aussi /sw.js (service worker, non versionné par hash).
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_next/static/" CACHE_IMMUTABLE
</IfModule>
<IfModule mod_headers.c>
  # Assets versionnés par hash de contenu : le nom change dès que le contenu
  # change (vérifié : 73 chunks communs entre deux builds, contenu identique).
  # Cache long + immutable, aucune revalidation.
  Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_IMMUTABLE
  # HTML : « garder mais toujours revalider » — le navigateur repasse par le
  # serveur (304 via Last-Modified si inchangé, quasi aucun coût réseau) et ne
  # peut plus servir une page périmée après un déploiement.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteBase /

# Page de debug /test retirée du build — bloquer aussi l'ancien fichier
# test.html resté sur le serveur (l'extraction d'un tar.gz ne supprime pas
# les fichiers orphelins). R=404 renvoie un vrai statut 404.
RewriteRule ^test(\.html)?/?$ - [R=404,L]

# 1. Fichiers réels (_next/, images, etc.) — servis directement
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Pages Next.js : /route ou /route/ → route.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ /$1.html [L]

# 3. Pages Next.js (trailingSlash) : /route/ → route/index.html
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*?)/?$ /$1/index.html [L]

# 4. Dossiers réels (_next/, etc.) — servis directement
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. Tout le reste → 404
RewriteRule ^ /404.html [L]
