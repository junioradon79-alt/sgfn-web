Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# MIME types explicites pour les assets
AddType text/css .css
AddType application/javascript .js
AddType application/json .json
AddType image/svg+xml .svg
AddType font/woff2 .woff2

# Autoriser explicitement l'accès aux fichiers (contourne un éventuel
# blocage des chemins commençant par underscore, ex. _next/)
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

RewriteEngine On
RewriteBase /

# 1. Fichiers réels (_next/, images, etc.) — servis directement
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2. Pages Next.js : /route ou /route/ → route.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ /$1.html [L]

# 3. Pages Next.js (trailingSlash) : /route/ → route/index.html
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*?)/?$ /$1/index.html [L]

# 4. Dossiers réels (_next/, etc.) — servis directement
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. Tout le reste → 404
RewriteRule ^ /404.html [L]
